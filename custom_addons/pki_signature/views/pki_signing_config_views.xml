<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pki_signing_config_form" model="ir.ui.view">
        <field name="name">pki.signing.config.form</field>
        <field name="model">pki.signing.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="require_visual_signature"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <separator string="Fields to Include in Digital Signature Hash"/>
                    <div class="text-muted mb-2">
                        Select the fields whose values will be cryptographically signed.
                        Any change to these fields after signing will be detected as tampering.
                        If no fields are selected, default business fields are used.
                    </div>
                    <field name="field_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pki_signing_config_list" model="ir.ui.view">
        <field name="name">pki.signing.config.list</field>
        <field name="model">pki.signing.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_id"/>
                <field name="field_ids" widget="many2many_tags"/>
                <field name="require_visual_signature"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_pki_signing_config" model="ir.actions.act_window">
        <field name="name">Digital Signature Settings</field>
        <field name="res_model">pki.signing.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Digital Signature Requirements
            </p>
            <p>
                Select which document types require digital signing during approval.
                Documents without a configuration here will be approved without PKI signing.
            </p>
        </field>
    </record>

</odoo>
