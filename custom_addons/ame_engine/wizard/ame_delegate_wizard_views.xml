<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ame_delegate_wizard_form" model="ir.ui.view">
        <field name="name">ame.delegate.wizard.form</field>
        <field name="model">ame.delegate.wizard</field>
        <field name="arch" type="xml">
            <form string="Delegate Approval">
                <group>
                    <field name="line_id" invisible="1"/>
                    <field name="delegate_to_id"/>
                    <field name="comment" placeholder="Reason for delegation..."/>
                </group>
                <footer>
                    <button name="action_delegate" string="Delegate" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
