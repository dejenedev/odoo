<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ame_approval_group_form" model="ir.ui.view">
        <field name="name">ame.approval.group.form</field>
        <field name="model">ame.approval.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="name"/><field name="min_approvals"/><field name="company_id"/><field name="active"/></group>
                    </group>
                    <field name="member_ids" widget="many2many_tags"/>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ame_approval_group_list" model="ir.ui.view">
        <field name="name">ame.approval.group.list</field>
        <field name="model">ame.approval.group</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="member_ids" widget="many2many_tags"/><field name="min_approvals"/></list>
        </field>
    </record>
    <record id="action_ame_approval_group" model="ir.actions.act_window">
        <field name="name">Approval Groups</field>
        <field name="res_model">ame.approval.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
