<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ame_condition_form" model="ir.ui.view">
        <field name="name">ame.condition.form</field>
        <field name="model">ame.condition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Condition">
                            <field name="attribute_id"/>
                            <field name="attribute_value_type" invisible="1"/>
                            <field name="transaction_type_id" invisible="1"/>
                            <field name="operator"/>
                            <field name="active"/>
                        </group>
                        <group string="Value">
                            <field name="value_float" string="Value"
                                   invisible="attribute_value_type != 'float' or operator == 'between'"
                                   required="attribute_value_type == 'float' and operator != 'between'"/>
                            <field name="value_float" string="From (Lower Bound)"
                                   invisible="operator != 'between'"/>
                            <field name="value_float_2" string="To (Upper Bound)"
                                   invisible="operator != 'between'"
                                   required="operator == 'between'"/>
                            <field name="value_char"
                                   invisible="attribute_value_type == 'float'"
                                   required="attribute_value_type != 'float'"/>
                        </group>
                    </group>
                    <group invisible="operator != 'between'">
                        <div class="text-muted">
                            Condition will match when the attribute value is between
                            the lower and upper bounds (inclusive).
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ame_condition_list" model="ir.ui.view">
        <field name="name">ame.condition.list</field>
        <field name="model">ame.condition</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="attribute_id"/><field name="operator"/><field name="value_float"/><field name="value_char"/></list>
        </field>
    </record>
    <record id="action_ame_condition" model="ir.actions.act_window">
        <field name="name">Conditions</field>
        <field name="res_model">ame.condition</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
