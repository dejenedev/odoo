<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ame_rule_form" model="ir.ui.view">
        <field name="name">ame.rule.form</field>
        <field name="model">ame.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="transaction_type_id"/>
                            <field name="approver_action_id"/>
                        </group>
                        <group>
                            <field name="priority"/>
                            <field name="sequence"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <separator string="Conditions (AND Logic)"/>
                    <div class="text-muted mb-2">
                        All conditions must be TRUE for this rule to fire. For OR logic, create separate rules.
                    </div>
                    <field name="condition_ids" nolabel="1"
                           domain="[('transaction_type_id', '=', transaction_type_id)]">
                        <list>
                            <field name="name"/>
                            <field name="attribute_id"/>
                            <field name="operator"/>
                            <field name="value_float"/>
                            <field name="value_char"/>
                        </list>
                    </field>
                    <field name="description" placeholder="Rule description..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ame_rule_list" model="ir.ui.view">
        <field name="name">ame.rule.list</field>
        <field name="model">ame.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="priority"/>
                <field name="name"/>
                <field name="transaction_type_id"/>
                <field name="condition_ids" widget="many2many_tags"/>
                <field name="approver_action_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="action_ame_rule" model="ir.actions.act_window">
        <field name="name">Rules</field>
        <field name="res_model">ame.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
