<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ame_substitution_form" model="ir.ui.view">
        <field name="name">ame.substitution.form</field>
        <field name="model">ame.substitution</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group><field name="original_user_id"/><field name="substitute_id"/><field name="reason"/></group>
                        <group><field name="start_date"/><field name="end_date"/><field name="company_id"/><field name="active"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_ame_substitution_list" model="ir.ui.view">
        <field name="name">ame.substitution.list</field>
        <field name="model">ame.substitution</field>
        <field name="arch" type="xml">
            <list><field name="original_user_id"/><field name="substitute_id"/><field name="reason"/><field name="start_date"/><field name="end_date"/><field name="active"/></list>
        </field>
    </record>
    <record id="action_ame_substitution" model="ir.actions.act_window">
        <field name="name">Substitution Rules</field>
        <field name="res_model">ame.substitution</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
