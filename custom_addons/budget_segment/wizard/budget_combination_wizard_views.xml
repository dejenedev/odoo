<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_budget_combination_wizard_form" model="ir.ui.view">
        <field name="name">budget.combination.wizard.form</field>
        <field name="model">budget.combination.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Budget Code">
                <field name="state" invisible="1"/>
                <field name="move_line_id" invisible="1"/>
                <field name="combination_id" invisible="1"/>
                <field name="account_id" invisible="1"/>
                <group invisible="state != 'found'">
                    <group>
                        <field name="combination_code" readonly="1"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="false" delete="false">
                        <field name="segment_name" string="Segment" readonly="1"/>
                        <field name="segment_type_id" column_invisible="1"/>
                        <field name="is_economic" column_invisible="1"/>
                        <field name="value_code" column_invisible="1"/>
                        <field name="segment_value_id" string="Value"
                               options="{'no_create': True}"
                               readonly="is_economic"
                               force_save="1"/>
                        <field name="value_description" string="Value"
                               readonly="1"/>
                    </list>
                </field>
                <group invisible="not message">
                    <div colspan="2">
                        <field name="message" nolabel="1" readonly="1"
                               class="text-info fw-bold"
                               invisible="state != 'found'"/>
                        <field name="message" nolabel="1" readonly="1"
                               class="text-danger fw-bold"
                               invisible="state != 'not_found'"/>
                    </div>
                </group>
                <footer>
                    <button name="action_search" string="Search" type="object"
                            class="btn-primary"
                            invisible="state == 'found'"/>
                    <button name="action_confirm" string="Confirm &amp; Assign" type="object"
                            class="btn-primary"
                            invisible="state != 'found'"/>
                    <button name="action_clear" string="Clear Budget Code" type="object"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
