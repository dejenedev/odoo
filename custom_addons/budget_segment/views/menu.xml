<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root Menu under Accounting/Invoicing -->
    <menuitem id="menu_budget_segment_root"
              name="GL Settings"
              parent="account.menu_finance_configuration"
              sequence="50"/>

    <!-- Organizations -->
    <menuitem id="menu_budget_organization"
              name="Organizations"
              parent="menu_budget_segment_root"
              action="action_budget_organization"
              sequence="5"/>

    <!-- Segment Types -->
    <menuitem id="menu_budget_segment_type"
              name="Segment Types"
              parent="menu_budget_segment_root"
              action="action_budget_segment_type"
              sequence="10"/>

    <!-- Segment Values (Non-Economic) -->
    <menuitem id="menu_budget_segment_value"
              name="Segment Values"
              parent="menu_budget_segment_root"
              action="action_budget_segment_value"
              sequence="20"/>

    <!-- Segment Values (Economic) -->
    <menuitem id="menu_budget_segment_value_economic"
              name="Economic Segment Values"
              parent="menu_budget_segment_root"
              action="action_budget_segment_value_economic"
              sequence="25"/>

    <!-- Code Combinations -->
    <menuitem id="menu_budget_code_combination"
              name="Code Combinations"
              parent="menu_budget_segment_root"
              action="action_budget_code_combination"
              sequence="30"/>

    <!-- Trial Balance -->
    <menuitem id="menu_budget_trial_balance"
              name="Trial Balance by Segment"
              parent="menu_budget_segment_root"
              action="action_budget_trial_balance"
              sequence="35"/>

    <menuitem id="menu_budget_combination_trial_balance"
              name="Trial Balance by Code Combination"
              parent="menu_budget_segment_root"
              action="action_budget_combination_trial_balance"
              sequence="36"/>

    <!-- Metabase BI Dashboard -->
    <record id="action_metabase_dashboard" model="ir.actions.client">
        <field name="name">BI Dashboard</field>
        <field name="tag">metabase_dashboard</field>
    </record>

    <menuitem id="menu_metabase_dashboard"
              name="BI Dashboard"
              parent="menu_budget_segment_root"
              action="action_metabase_dashboard"
              sequence="38"/>

    <!-- Payment Consolidation -->
    <menuitem id="menu_budget_payment_consolidation"
              name="Payment Consolidation"
              parent="menu_budget_segment_root"
              action="action_budget_payment_consolidation"
              sequence="40"/>

</odoo>
