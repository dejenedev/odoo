<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Segment Type Form View -->
    <record id="view_budget_segment_type_form" model="ir.ui.view">
        <field name="name">budget.segment.type.form</field>
        <field name="model">budget.segment.type</field>
        <field name="arch" type="xml">
            <form string="Budget Segment Type">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Organization Segment"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="total_digits"/>
                        </group>
                        <group>
                            <field name="is_economic"/>
                            <field name="separator"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Levels">
                            <field name="level_ids">
                                <list editable="bottom">
                                    <field name="level_number"/>
                                    <field name="name"/>
                                    <field name="digit_count" string="Number of Digits"/>
                                    <field name="is_leaf" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Segment Type List View -->
    <record id="view_budget_segment_type_list" model="ir.ui.view">
        <field name="name">budget.segment.type.list</field>
        <field name="model">budget.segment.type</field>
        <field name="arch" type="xml">
            <list string="Budget Segment Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="total_digits"/>
                <field name="is_economic"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Segment Type Action -->
    <record id="action_budget_segment_type" model="ir.actions.act_window">
        <field name="name">Segment Types</field>
        <field name="res_model">budget.segment.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your budget segment types
            </p>
            <p>
                Create segment types such as Organization, Geographic, Program,
                Project, Fund Source, Economic, and Counterparty.
                Set the display order to control how segments appear in code combinations.
            </p>
        </field>
    </record>

</odoo>
