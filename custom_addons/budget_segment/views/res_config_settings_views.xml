<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_budget_segment" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.budget.segment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Budget Segments" name="budget_segment_settings">
                    <setting string="Code Combination Mode"
                             help="Control how budget code combinations are handled on transactions">
                        <field name="budget_auto_create_combination" widget="radio"/>
                    </setting>
                </block>
                <block title="BI Dashboard (Metabase)" name="metabase_settings">
                    <setting string="Metabase URL"
                             help="Base URL of the Metabase server">
                        <field name="metabase_url" placeholder="http://localhost:3000"/>
                    </setting>
                    <setting string="Dashboard Public UUID"
                             help="Public UUID from Metabase sharing link">
                        <field name="metabase_dashboard_id"
                               placeholder="e.g. 01d8c811-f13b-4fc4-af61-ce5d04eafce1"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
